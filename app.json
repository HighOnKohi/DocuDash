{
  "expo": {
    "name": "DocuDash",
    "slug": "docudash",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "docudash",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "ph.gov.barangay.docudash"
    },
    "android": {
      "package": "ph.gov.barangay.docudash",
      "adaptiveIcon": {
        "backgroundColor": "#01227F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "DocuDash",
      "shortName": "DocuDash",
      "themeColor": "#01227F",
      "backgroundColor": "#F8FAFC"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://docu-dash-ph.vercel.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DocuDash to access your camera to scan resident QR pickup passes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "cmakeVersion": "3.31.6"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://docu-dash-ph.vercel.app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "34aba42c-05e9-4a1b-8179-942036cc8c30"
      }
    }
  }
}
