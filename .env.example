# =============================================================================
# DocuDash environment variables
# Copy to `.env.local` for local development. Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT (bundled into the app; safe to expose)
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle.
# -----------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Access is constrained by Row-Level Security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Vercel deployment hosting /api functions.
# Native apps need an absolute URL; on web this may be left empty to use the same origin.
EXPO_PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
# SERVER ONLY (Vercel Project Settings -> Environment Variables)
# NEVER prefix these with EXPO_PUBLIC_ and never import them from app/, components/, or services/.
# -----------------------------------------------------------------------------

# Same value as EXPO_PUBLIC_SUPABASE_URL; read by /api functions.
SUPABASE_URL=

# Service role key. Bypasses RLS. Used exclusively inside /api on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call /api (CORS), e.g.
# https://docudash.vercel.app,http://localhost:8081
ALLOWED_ORIGINS=

# Optional: shared secret for protected maintenance jobs (e.g. attachment retention purge via Vercel Cron).
CRON_SECRET=

# Optional: Resend email delivery for /api/notify-resident (falls back to in-app Realtime + audit log when unset).
# Use a sending-only API key (never full-access) and a verified domain sender (or "DocuDash <onboarding@resend.dev>" for sandbox testing).
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=DocuDash <onboarding@resend.dev>
RESEND_TEMPLATE_ID=docudash-status-update
